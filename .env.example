DISCORD_TOKEN=your-bot-token
# MySQL/MariaDB connection string (see docker-compose.yml for the defaults)
DATABASE_URL=mysql://elimination:elimination@localhost:3306/elimination
# Optional; cron schedule for polling Torn elimination standings.
# Defaults to 10 seconds past every 5-minute mark: 10 */5 * * * *
ELIMINATION_CRON=
# Optional; cron schedule for the rotating team-member sync (one API call per run).
# Defaults to every minute: * * * * *
TEAM_MEMBERS_CRON=

# Push calendar ---------------------------------------------------------------
# Discord user id allowed to run /push (the bot owner)
OWNER_ID=
# OAuth app credentials (same Discord application as the bot; you must add the
# redirect URI <WEB_PUBLIC_URL>/api/auth/callback in the Discord Developer Portal)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Public base URL of the web calendar. Example: https://push.example.com
# For local testing against a bot run on your machine, use http://localhost:3000
WEB_PUBLIC_URL=
# Port the built-in web server listens on (only reachable via the proxy in prod)
WEB_PORT=3000

# Traefik / docker compose (PUSH_DOMAIN must be in .env if you run compose)
PUSH_DOMAIN=push.example.com
ACME_EMAIL=admin@example.com
MARIADB_PASSWORD=elimination
MARIADB_ROOT_PASSWORD=root
